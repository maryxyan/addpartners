NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
FRONTEND_ORIGIN=https://addpartners.ro,https://www.addpartners.ro
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Attach a Railway volume at /data and keep this path.
UPLOAD_DIR=/data/uploads
LOG_LEVEL=info
